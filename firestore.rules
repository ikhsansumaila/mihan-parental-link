rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Email terverifikasi dari token (akun Google selalu terverifikasi), huruf kecil.
    function myEmail() {
      return request.auth.token.email_verified == true ? request.auth.token.email.lower() : null;
    }

    // Gmail anak yang didaftarkan orang tua. ID dokumen = Gmail huruf kecil.
    match /children/{email} {
      allow create: if signedIn()
        && email.matches('^[^@\\s]+@[^@\\s]+$')
        && email == email.lower()
        && email != request.auth.token.email.lower()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.email == email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      // Hanya pemilik yang boleh mengubah; kepemilikan tidak bisa dipindah.
      allow update: if signedIn()
        && resource.data.ownerUid == uid()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.email == email;
      allow delete: if signedIn() && resource.data.ownerUid == uid();
      // Orang tua membaca miliknya; anak hanya dokumen dengan Gmail-nya sendiri.
      allow get: if signedIn() && (resource.data.ownerUid == uid() || email == myEmail());
      allow list: if signedIn() && resource.data.ownerUid == uid();
    }

    match /devices/{deviceId} {
      function isOwner() { return signedIn() && resource.data.ownerUid == uid(); }
      function isChild() { return signedIn() && resource.data.childUid == uid(); }
      function childReg(email) { return /databases/$(database)/documents/children/$(email); }

      // resource == null → dokumen sudah dihapus; HP anak perlu tahu supaya melepas proteksi.
      allow get: if signedIn() && (resource == null || isOwner() || isChild());
      // Orang tua: semua device miliknya. Anak: device miliknya sendiri (dipakai saat instal ulang).
      allow list: if signedIn() && (resource.data.ownerUid == uid() || resource.data.childUid == uid());

      // HP anak membuat dokumen dengan Gmail yang sudah didaftarkan orang tua.
      allow create: if signedIn()
        && myEmail() != null
        && request.resource.data.childUid == uid()
        && request.resource.data.childEmail == myEmail()
        && exists(childReg(myEmail()))
        && get(childReg(myEmail())).data.ownerUid == request.resource.data.ownerUid;

      // Orang tua: boleh ubah apa saja kecuali kepemilikan.
      // Anak: hanya status & lastSeen (tidak bisa mengubah jadwal).
      allow update: if (isOwner()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.childUid == resource.data.childUid)
        || (isChild()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastSeen']));

      allow delete: if isOwner();

      // Pesan dari HP anak ke orang tua.
      match /messages/{msgId} {
        function dev() { return get(/databases/$(database)/documents/devices/$(deviceId)).data; }

        // Hanya HP anak pemilik device; isi dibatasi; waktu harus waktu server.
        allow create: if signedIn()
          && dev().childUid == uid()
          && request.resource.data.keys().hasOnly(['text', 'createdAt', 'read'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
        allow read: if signedIn() && (dev().ownerUid == uid() || dev().childUid == uid());
        // Orang tua hanya boleh menandai sudah dibaca.
        allow update: if signedIn()
          && dev().ownerUid == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if signedIn() && dev().ownerUid == uid();
      }
    }
  }
}
